# Universal I/O — API Gateway
#
# このファイルは環境変数の正本です。コードが実際に読む変数
# （`grep -rhoE "process\.env\.[A-Z_0-9]+" lib app scripts` で確認できる）と
# 一致させてください。値は入れずキー名だけを保つこと。
#
# 本番の値は Vercel の Project Settings → Environment Variables にあり、
# ローカルの .env.local とは別物です（Stripeのtest/live鍵など）。

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# サーバー専用。クライアントへ絶対に露出させない
SUPABASE_SERVICE_ROLE_KEY=

# --- クライアントが叩くGatewayのベースURL ---
NEXT_PUBLIC_BOMB_SQUAD_API_BASE_URL=http://localhost:3000/api

# --- AIプロバイダ（すべてサーバー専用） ---
# 一次・二次のモデル順序は lib/server/ai-routing.ts が唯一の正本
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# --- Stripe（サーバー専用） ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- 管理コンソール ---
# /admin に入れるメールアドレスのカンマ区切り。空＝管理者なし
ADMIN_EMAILS=
